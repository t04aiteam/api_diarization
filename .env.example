# Which backends /diarize can use (comma-separated) and which one is used
# when the client doesn't pass `model`.
ENABLED_MODELS=vibevoice
DEFAULT_MODEL=vibevoice

# pyannote is disabled by default: it's a gated model, so enabling it needs
# internet + a valid HF_TOKEN with the model's terms accepted on
# huggingface.co, then set:
#   ENABLED_MODELS=vibevoice,pyannote
# HF_TOKEN=

# Upload / duration limits
MAX_UPLOAD_MB=500
MAX_AUDIO_SECONDS=3600
MAX_NEW_TOKENS_DEFAULT=32768

# --- Test environment (this instance) ---
# Left unset/0 so `from_pretrained("microsoft/VibeVoice-ASR", ...)` can
# reach the Hub and download+cache the ~18 GB checkpoint (into
# ~/.cache/huggingface) the first time the service starts. Needs internet
# and enough disk space for that first run only; every run after uses the
# local cache.
LOCAL_FILES_ONLY=0
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- Locked-down / production mode ---
# Once the cache above is warm, flip these to 1 to pin the service to that
# cache and stop it from ever touching the network again (matches the
# original, network-locked deployment this test environment is standing in
# for). main.py calls load_dotenv() before any other import so these are
# guaranteed to be set before transformers/huggingface_hub load.
# LOCAL_FILES_ONLY=1
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
